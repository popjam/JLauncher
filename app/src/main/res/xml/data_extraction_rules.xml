<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup for Android 12 and higher: launcher settings and mood tracker data.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="sharedpref"
            path="app.olauncher.xml" />
        <include
            domain="file"
            path="mood/mood_data.json" />
    </cloud-backup>
</data-extraction-rules>
