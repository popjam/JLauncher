<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup for Android 12 and higher. Cloud backup only includes the mood tracker data;
   launcher settings are left out because they can hold the lockdown password.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="file"
            path="mood/mood_data.json" />
    </cloud-backup>
</data-extraction-rules>
