<!--
   Auto Backup for Android 11 and lower. Only the mood tracker data is backed up;
   launcher settings are left out because they can hold the lockdown password.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <include
        domain="file"
        path="mood/mood_data.json" />
</full-backup-content>
