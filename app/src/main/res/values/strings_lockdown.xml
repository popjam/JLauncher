    <!-- Breaks -->
    <string name="lockdown_breaks">Breaks</string>
    <string name="info_lockdown_breaks">Time with nothing blocked, without ending lockdown. Lockdown earns break time into a pool; a break uses the pool, and ending it early puts what\'s left back. A break lifts lockdown on every device.</string>
