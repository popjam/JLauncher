<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <LinearLayout
            android:id="@+id/statNameSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:text="@string/stat_name"
                android:textColor="?attr/primaryColor"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/statName"
                style="@style/TextSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_box"
                android:hint="@string/stat_name_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="24"
                android:padding="12dp"
                android:shadowRadius="0"
                android:singleLine="true"
                android:textColor="?attr/primaryColor"
                android:textColorHint="?attr/primaryColorTrans50"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- The daily check's title while this stat is asked; hidden for Screen time -->
        <LinearLayout
            android:id="@+id/statQuestionSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statQuestionLabel"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:alpha="0.7"
                android:text="@string/stat_display_text"
                android:textColor="?attr/primaryColor"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/statQuestion"
                style="@style/TextSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_box"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="80"
                android:padding="12dp"
                android:shadowRadius="0"
                android:singleLine="true"
                android:textColor="?attr/primaryColor"
                android:textColorHint="?attr/primaryColorTrans50"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Happy face on the left, and sad counting highest in the graphs -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/statInverted"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/stat_invert"
            android:textColor="?attr/primaryColor"
            android:textSize="15sp" />

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:text="@string/stat_invert_hint"
            android:textColor="?attr/primaryColor"
            android:textSize="12sp" />

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0.7"
            android:text="@string/stat_colour"
            android:textColor="?attr/primaryColor"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <app.olauncher.ui.ColorWheelView
                android:id="@+id/statColorWheel"
                android:layout_width="140dp"
                android:layout_height="140dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <View
                    android:id="@+id/statColorSwatch"
                    android:layout_width="46dp"
                    android:layout_height="46dp" />

                <TextView
                    android:id="@+id/statColorHex"
                    style="@style/TextSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:alpha="0.6"
                    android:textColor="?attr/primaryColor"
                    android:textSize="12sp"
                    tools:text="#5B8DEF" />
            </LinearLayout>
        </LinearLayout>

        <SeekBar
            android:id="@+id/statBrightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/stat_brightness"
            android:max="100" />

        <LinearLayout
            android:id="@+id/statOptionsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/statDaily"
                style="@style/TextSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/stat_daily_check"
                android:textColor="?attr/primaryColor"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/statScaleLabel"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:alpha="0.7"
                android:text="@string/stat_scale"
                android:textColor="?attr/primaryColor"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/statScales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:alpha="0.7"
                    android:text="@string/stat_face_labels"
                    android:textColor="?attr/primaryColor"
                    android:textSize="14sp" />

                <!-- Empties every label box -->
                <TextView
                    android:id="@+id/statClearLabels"
                    style="@style/TextSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="6dp"
                    android:text="@string/clear"
                    android:textColor="?attr/primaryColor"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- A face and a label box for each face of the scale -->
            <LinearLayout
                android:id="@+id/statFaceLabels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
