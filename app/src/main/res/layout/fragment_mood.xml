<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryShadeDarkColor"
    android:clickable="true"
    android:focusable="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="48dp">

            <!-- Tabs scroll sideways when there are many stats; + stays put. Long-press a tab to edit it. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/rounded_rect_shade_color"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <HorizontalScrollView
                    android:id="@+id/tabScroll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fadingEdgeLength="24dp"
                    android:overScrollMode="never"
                    android:requiresFadingEdge="horizontal"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/tabRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/addStat"
                    style="@style/TextLarge"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_add_stat"
                    android:contentDescription="@string/new_stat"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="+"
                    android:textColor="?attr/primaryColor"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- Selected day -->
            <LinearLayout
                android:id="@+id/dayCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:animateLayoutChanges="true"
                android:background="@drawable/rounded_rect_shade_color"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/dayLabel"
                    style="@style/TextSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:textColor="?attr/primaryColor"
                    android:textSize="14sp"
                    tools:text="Today" />

                <LinearLayout
                    android:id="@+id/moodFaces"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/usageRow"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <app.olauncher.ui.PixelFaceView
                        android:id="@+id/usageFace"
                        android:layout_width="40dp"
                        android:layout_height="40dp" />

                    <TextView
                        android:id="@+id/usageTime"
                        style="@style/TextLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:textColor="?attr/primaryColor"
                        android:textSize="26sp"
                        tools:text="4h 37m" />
                </LinearLayout>

                <TextView
                    style="@style/TextSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginTop="12dp"
                    android:alpha="0.7"
                    android:text="@string/thoughts"
                    android:textColor="?attr/primaryColor"
                    android:textSize="14sp" />

                <!-- Saved when it loses focus, when another day is picked, and when leaving -->
                <EditText
                    android:id="@+id/noteInput"
                    style="@style/TextSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/rounded_box"
                    android:gravity="top|start"
                    android:hint="@string/thoughts_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="2000"
                    android:minLines="2"
                    android:padding="12dp"
                    android:shadowRadius="0"
                    android:textColor="?attr/primaryColor"
                    android:textColorHint="?attr/primaryColorTrans50"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Calendar -->
            <LinearLayout
                android:id="@+id/calendarCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/rounded_rect_shade_color"
                android:orientation="vertical"
                android:padding="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/prevMonth"
                        style="@style/TextLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:contentDescription="@string/previous_month"
                        android:paddingHorizontal="16dp"
                        android:text="‹"
                        android:textColor="?attr/primaryColor" />

                    <TextView
                        android:id="@+id/monthTitle"
                        style="@style/TextSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="?attr/primaryColor"
                        tools:text="October 2026" />

                    <TextView
                        android:id="@+id/nextMonth"
                        style="@style/TextLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:contentDescription="@string/next_month"
                        android:paddingHorizontal="16dp"
                        android:text="›"
                        android:textColor="?attr/primaryColor" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/weekdayHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/calendarGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- All: weekly totals of every stat over a year -->
            <LinearLayout
                android:id="@+id/graphCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/rounded_rect_shade_color"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/prevGraph"
                        style="@style/TextLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:contentDescription="@string/previous_year"
                        android:paddingHorizontal="16dp"
                        android:text="‹"
                        android:textColor="?attr/primaryColor" />

                    <TextView
                        android:id="@+id/graphTitle"
                        style="@style/TextSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/switch_graph"
                        android:padding="8dp"
                        android:textColor="?attr/primaryColor"
                        tools:text="2026 · weekly  ⇄" />

                    <TextView
                        android:id="@+id/nextGraph"
                        style="@style/TextLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:contentDescription="@string/next_year"
                        android:paddingHorizontal="16dp"
                        android:text="›"
                        android:textColor="?attr/primaryColor" />
                </FrameLayout>

                <app.olauncher.ui.StatChartView
                    android:id="@+id/statChart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp" />

                <TextView
                    android:id="@+id/graphEmpty"
                    style="@style/TextSmall"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:alpha="0.6"
                    android:gravity="center"
                    android:text="@string/no_data"
                    android:textColor="?attr/primaryColor"
                    android:visibility="gone" />

                <!-- The tapped week's totals -->
                <TextView
                    android:id="@+id/pointDetails"
                    style="@style/TextSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:textColor="?attr/primaryColor"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Week 31" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/graphToggles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/rounded_rect_shade_color"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextSmall"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:alpha="0.7"
                        android:text="@string/show"
                        android:textColor="?attr/primaryColor"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/selectAllStats"
                        style="@style/TextSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:text="@string/select_all"
                        android:textColor="?attr/primaryColor"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/clearStats"
                        style="@style/TextSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:padding="6dp"
                        android:text="@string/clear"
                        android:textColor="?attr/primaryColor"
                        android:textSize="13sp" />
                </LinearLayout>

                <app.olauncher.ui.FlowLayout
                    android:id="@+id/graphChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
