<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryShadeDarkColor"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="12dp"
        android:animateLayoutChanges="true"
        android:background="@drawable/rounded_rect_shade_color"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="24dp">

        <!-- The breathing pause -->
        <LinearLayout
            android:id="@+id/pauseBreathing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pauseAppName"
                style="@style/TextLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/primaryColor"
                tools:text="Reddit" />

            <TextView
                android:id="@+id/pauseMessage"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.7"
                android:text="@string/take_a_breath"
                android:textColor="?attr/primaryColor" />

            <!-- Breathing circle with the countdown in the middle -->
            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginVertical="24dp">

                <View
                    android:id="@+id/breathCircle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.12"
                    android:background="@drawable/page_dot" />

                <TextView
                    android:id="@+id/pauseCountdown"
                    style="@style/TextLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="?attr/primaryColor"
                    android:textSize="40sp"
                    tools:text="10" />
            </FrameLayout>
        </LinearLayout>

        <!-- How long to use the app for -->
        <LinearLayout
            android:id="@+id/useForLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/useForTitle"
                style="@style/TextLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:gravity="center"
                android:textColor="?attr/primaryColor"
                tools:text="How long do you want to use Reddit for?" />

            <LinearLayout
                android:id="@+id/useForOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="24dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/useFor2"
                    style="@style/TextSmallBold"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_box"
                    android:gravity="center"
                    android:textColor="?attr/primaryColor"
                    tools:text="2m" />

                <TextView
                    android:id="@+id/useFor5"
                    style="@style/TextSmallBold"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_box"
                    android:gravity="center"
                    android:textColor="?attr/primaryColor"
                    tools:text="5m" />

                <TextView
                    android:id="@+id/useFor10"
                    style="@style/TextSmallBold"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_box"
                    android:gravity="center"
                    android:textColor="?attr/primaryColor"
                    tools:text="10m" />

                <TextView
                    android:id="@+id/useFor30"
                    style="@style/TextSmallBold"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_box"
                    android:gravity="center"
                    android:textColor="?attr/primaryColor"
                    tools:text="30m" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pauseCancel"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:text="@string/cancel"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:id="@+id/pauseOpen"
                style="@style/TextSmallBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:textColor="?attr/primaryColor"
                tools:text="Open in 10" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
