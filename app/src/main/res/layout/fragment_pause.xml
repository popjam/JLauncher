<?xml version="1.0" encoding="utf-8"?>
<!-- The pause before a chosen app, as Lockdown's bottom sheet. See PauseScreen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="40dp"
        android:animateLayoutChanges="true"
        android:background="@drawable/sheet_card"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="18dp">

        <!-- Face beside the title, which is the question for each step -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <app.olauncher.ui.PixelFaceView
                android:id="@+id/pauseFace"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="14dp" />

            <TextView
                android:id="@+id/pauseAppName"
                style="@style/SheetText.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Open Reddit?" />
        </LinearLayout>

        <!-- Filled in once today's usage has been read, if usage access is on -->
        <TextView
            android:id="@+id/pauseUsage"
            style="@style/SheetText.Line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            tools:text="12% of today so far on Reddit"
            tools:visibility="visible" />

        <!-- The breathing pause -->
        <LinearLayout
            android:id="@+id/pauseBreathing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pauseMessage"
                style="@style/SheetText.Line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/take_a_breath" />

            <!-- Breathing circle with the countdown in the middle -->
            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="12dp">

                <View
                    android:id="@+id/breathCircle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.12"
                    android:background="@drawable/sheet_circle" />

                <TextView
                    android:id="@+id/pauseCountdown"
                    style="@style/SheetText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textSize="@dimen/size_figure"
                    tools:text="10" />
            </FrameLayout>
        </LinearLayout>

        <!-- How long to use the app for -->
        <LinearLayout
            android:id="@+id/useForLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/useFor2"
                style="@style/SheetText.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:textStyle="bold"
                tools:text="2m" />

            <TextView
                android:id="@+id/useFor5"
                style="@style/SheetText.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:textStyle="bold"
                tools:text="5m" />

            <TextView
                android:id="@+id/useFor10"
                style="@style/SheetText.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:textStyle="bold"
                tools:text="10m" />

            <TextView
                android:id="@+id/useFor30"
                style="@style/SheetText.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:textStyle="bold"
                tools:text="30m" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pauseCancel"
                style="@style/SheetText.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cancel" />

            <TextView
                android:id="@+id/pauseOpen"
                style="@style/SheetText.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textStyle="bold"
                tools:text="Open in 10" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
