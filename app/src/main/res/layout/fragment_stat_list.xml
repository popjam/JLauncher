<?xml version="1.0" encoding="utf-8"?>
<!-- Pulled down to close -->
<app.olauncher.ui.PullDismissLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/primaryShadeDarkColor"
        android:clickable="true"
        android:focusable="true">

        <ScrollView
            android:id="@+id/statScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="48dp">

                <!-- The title; pulling down or Back closes the page -->
                <TextView
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginBottom="16dp"
                    android:paddingVertical="4dp"
                    android:text="@string/stats_title"
                    android:textColor="?attr/primaryColor"
                    android:textSize="@dimen/size_large" />

                <!-- Home, a row per stat in its order, and a new stat -->
                <LinearLayout
                    android:id="@+id/statRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</app.olauncher.ui.PullDismissLayout>
