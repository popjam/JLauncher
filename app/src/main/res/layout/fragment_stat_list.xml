<?xml version="1.0" encoding="utf-8"?>
<!-- Swiped away sideways when opened by a swipe on the home screen -->
<app.olauncher.ui.PullDismissLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/primaryShadeDarkColor"
        android:clickable="true"
        android:focusable="true">

        <ScrollView
            android:id="@+id/statScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="48dp">

                <!-- Back to the home screen, and the title -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/back"
                        style="@style/TextLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:contentDescription="@string/back"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="‹"
                        android:textColor="?attr/primaryColor" />

                    <TextView
                        style="@style/TextLarge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/stats_title"
                        android:textColor="?attr/primaryColor"
                        android:textSize="28sp" />
                </LinearLayout>

                <!-- Home, a row per stat in its order, and a new stat -->
                <LinearLayout
                    android:id="@+id/statRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</app.olauncher.ui.PullDismissLayout>
