<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="app.olauncher.ui.HomeFragment"
        android:label="main_fragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_mainFragment_to_appListFragment"
            app:destination="@id/appListFragment"
            app:enterAnim="@anim/fade_enter"
            app:exitAnim="@anim/slide_out_top"
            app:popEnterAnim="@anim/slide_in_top"
            app:popExitAnim="@anim/fade_exit" />
        <action
            android:id="@+id/action_mainFragment_to_settingsFragment"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/fade_enter"
            app:exitAnim="@anim/fade_exit"
            app:popEnterAnim="@anim/fade_enter"
            app:popExitAnim="@anim/fade_exit" />
        <action
            android:id="@+id/action_mainFragment_to_statListFragment"
            app:destination="@id/statListFragment"
            app:enterAnim="@anim/fade_enter"
            app:exitAnim="@anim/fade_exit"
            app:popEnterAnim="@anim/fade_enter"
            app:popExitAnim="@anim/fade_exit" />
        <action
            android:id="@+id/action_mainFragment_to_statFragment"
            app:destination="@id/statFragment"
            app:enterAnim="@anim/fade_enter"
            app:exitAnim="@anim/fade_exit"
            app:popEnterAnim="@anim/fade_enter"
            app:popExitAnim="@anim/fade_exit" />
        <action
            android:id="@+id/action_mainFragment_to_weatherFragment"
            app:destination="@id/weatherFragment"
            app:enterAnim="@anim/fade_enter"
            app:exitAnim="@anim/fade_exit"
            app:popEnterAnim="@anim/fade_enter"
            app:popExitAnim="@anim/fade_exit" />
    </fragment>

    <fragment
        android:id="@+id/weatherFragment"
        android:name="app.olauncher.ui.WeatherFragment"
        android:label="WeatherFragment"
        tools:layout="@layout/fragment_weather" />

    <!-- The stat pages, opened from the stat list -->
    <fragment
        android:id="@+id/statFragment"
        android:name="app.olauncher.ui.StatFragment"
        android:label="StatFragment"
        tools:layout="@layout/fragment_stat" />

    <fragment
        android:id="@+id/statListFragment"
        android:name="app.olauncher.ui.StatListFragment"
        android:label="StatListFragment"
        tools:layout="@layout/fragment_stat_list">
        <action
            android:id="@+id/action_statListFragment_to_statFragment"
            app:destination="@id/statFragment"
            app:enterAnim="@anim/fade_enter"
            app:exitAnim="@anim/fade_exit"
            app:popEnterAnim="@anim/fade_enter"
            app:popExitAnim="@anim/fade_exit" />
        <action
            android:id="@+id/action_statListFragment_to_journalFragment"
            app:destination="@id/journalFragment"
            app:enterAnim="@anim/fade_enter"
            app:exitAnim="@anim/fade_exit"
            app:popEnterAnim="@anim/fade_enter"
            app:popExitAnim="@anim/fade_exit" />
        <action
            android:id="@+id/action_statListFragment_to_statsHomeFragment"
            app:destination="@id/statsHomeFragment"
            app:enterAnim="@anim/fade_enter"
            app:exitAnim="@anim/fade_exit"
            app:popEnterAnim="@anim/fade_enter"
            app:popExitAnim="@anim/fade_exit" />
    </fragment>

    <!-- Every note written, searchable, from the stat list -->
    <fragment
        android:id="@+id/journalFragment"
        android:name="app.olauncher.ui.JournalFragment"
        android:label="JournalFragment">
    </fragment>

    <!-- Everything about one day, and changing it -->
    <fragment
        android:id="@+id/dayFragment"
        android:name="app.olauncher.ui.DayFragment"
        android:label="DayFragment" />

    <!-- Every stat together, at the top of the stat list -->
    <fragment
        android:id="@+id/statsHomeFragment"
        android:name="app.olauncher.ui.StatsHomeFragment"
        android:label="StatsHomeFragment">
        <action
            android:id="@+id/action_statsHomeFragment_to_statFragment"
            app:destination="@id/statFragment"
            app:enterAnim="@anim/fade_enter"
            app:exitAnim="@anim/fade_exit"
            app:popEnterAnim="@anim/fade_enter"
            app:popExitAnim="@anim/fade_exit" />
    </fragment>

    <fragment
        android:id="@+id/appListFragment"
        android:name="app.olauncher.ui.AppDrawerFragment"
        android:label="app_list_fragment"
        tools:layout="@layout/fragment_app_drawer">
        <action
            android:id="@+id/action_appListFragment_to_settingsFragment2"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/fade_enter"
            app:exitAnim="@anim/fade_exit"
            app:popEnterAnim="@anim/fade_enter"
            app:popExitAnim="@anim/fade_exit"
            app:popUpTo="@+id/appListFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="app.olauncher.ui.SettingsFragment"
        android:label="SettingsFragment"
        android:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingsFragment_to_appListFragment"
            app:destination="@id/appListFragment"
            app:enterAnim="@anim/fade_enter"
            app:exitAnim="@anim/fade_exit"
            app:popEnterAnim="@anim/fade_enter"
            app:popExitAnim="@anim/fade_exit" />
        <action
            android:id="@+id/action_settingsFragment_to_pausedAppsFragment"
            app:destination="@id/pausedAppsFragment"
            app:enterAnim="@anim/fade_enter"
            app:exitAnim="@anim/fade_exit"
            app:popEnterAnim="@anim/fade_enter"
            app:popExitAnim="@anim/fade_exit" />
    </fragment>

    <fragment
        android:id="@+id/pausedAppsFragment"
        android:name="app.olauncher.ui.PausedAppsFragment"
        android:label="PausedAppsFragment"
        tools:layout="@layout/fragment_paused_apps" />

    <!-- Wellness pause before opening an app; always shown over the home screen -->
    <fragment
        android:id="@+id/pauseFragment"
        android:name="app.olauncher.ui.PauseFragment"
        android:label="PauseFragment"
        tools:layout="@layout/fragment_pause" />

    <!-- A day held anywhere opens its page -->
    <action
        android:id="@+id/action_global_dayFragment"
        app:destination="@id/dayFragment"
        app:enterAnim="@anim/fade_enter"
        app:exitAnim="@anim/fade_exit"
        app:popEnterAnim="@anim/fade_enter"
        app:popExitAnim="@anim/fade_exit" />

    <action
        android:id="@+id/action_global_pauseFragment"
        app:destination="@id/pauseFragment"
        app:enterAnim="@anim/fade_enter"
        app:exitAnim="@anim/fade_exit"
        app:popEnterAnim="@anim/fade_enter"
        app:popExitAnim="@anim/fade_exit"
        app:popUpTo="@id/mainFragment" />

</navigation>